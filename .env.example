# NVIDIA NIM API key -- free at https://build.nvidia.com (sign up, open any
# model page, click "Get API Key"; the key starts with nvapi-).
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXX

# Chat model used for extraction. Any chat model id from build.nvidia.com works.
NIM_MODEL=meta/llama-3.3-70b-instruct

# Cheaper model used for the per-field confidence judge pass.
NIM_JUDGE_MODEL=meta/llama-3.1-8b-instruct

# Default minimum overall confidence before POST /extract returns 422.
# Override per request with the ?min_confidence= query parameter.
CONFIDENCE_THRESHOLD=0.6
